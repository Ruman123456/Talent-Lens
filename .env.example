# Environment Configuration for TalentLens AI

# --- System & API ---
PROJECT_NAME="TalentLens AI"
API_V1_STR="/api"
DATABASE_URL="sqlite:///./backend/talentlens.db"

# --- LLM Provider Selection ---
# Options: "demo" (default local offline mode), "gemini", or "openai"
LLM_PROVIDER="demo"

# --- Google Gemini Settings (Required only if LLM_PROVIDER="gemini") ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# --- OpenAI Settings (Required only if LLM_PROVIDER="openai") ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# --- Sentence Transformers & ChromaDB Vector Store ---
EMBEDDING_MODEL="all-MiniLM-L6-v2"
CHROMA_PERSIST_DIRECTORY="./backend/chroma_db"

# --- Knowledge Base & Chunking ---
KNOWLEDGE_BASE_DIR="./backend/knowledge_base"
UPLOAD_DIRECTORY="./backend/uploads"
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.35

